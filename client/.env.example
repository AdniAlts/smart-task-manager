# ===========================================
# Frontend Environment Variables
# ===========================================
# For local development, copy this to .env.local and update values

# API URL - Your backend URL
# Local dev: http://localhost:3000/api
# Vercel: https://smart-task-manager-backend-delta.vercel.app/api
VITE_API_URL=https://smart-task-manager-backend-delta.vercel.app/api

# Telegram Bot Username (without @) - Optional
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
