# Environment variables for Vercel deployment

# Database Configuration (Choose one of the options from DATABASE_MIGRATION.md)
# Option 1: PlanetScale
DATABASE_URL=mysql://xxxxx:xxxxx@xxxxx.psdb.cloud/smart-task-manager?sslaccept=strict

# Option 2: Individual MySQL variables (Railway, Aiven, etc)
MYSQL_HOST=your-mysql-host.com
MYSQL_PORT=3306
MYSQL_USER=your-username
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database-name

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Email Service (Nodemailer - Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=TaskMind <your-email@gmail.com>

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend URL (will be your Vercel client URL after deployment)
FRONTEND_URL=https://your-frontend.vercel.app

# Vercel Cron Secret (generate a random string for security)
CRON_SECRET=your-random-cron-secret-key

# Node Environment
NODE_ENV=production
